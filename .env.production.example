# ============================================================================
# Miransas ID — Production Environment Template
# ============================================================================
# Copy to .env and fill in all required values.
# NEVER commit your .env file to version control.
# Generate secrets with: openssl rand -hex 32

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED: 32+ cryptographically random hex chars
SECRET_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=miransas
POSTGRES_PASSWORD=
POSTGRES_DB=miransas_id

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON list. NO wildcards in production.
# Example: ["https://console.miransas.com","https://app.miransas.com"]
CORS_ORIGINS=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@miransas.com
EMAIL_FROM_NAME=Miransas ID

# ── Frontend URL (for verification/reset links) ──────────────────────────────
APP_FRONTEND_URL=https://console.miransas.com

# ── Sentry (recommended) ─────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Application port ─────────────────────────────────────────────────────────
APP_PORT=8000
